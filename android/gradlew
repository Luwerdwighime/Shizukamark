#!/usr/bin/env bash
# Gradle Wrapper script generated by Antigravity
# This script downloads the Gradle distribution defined in gradle/wrapper/gradle-wrapper.properties
# and launches Gradle with the provided arguments.

# Resolve the directory containing this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WRAPPER_JAR="$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.jar"

# Execute the wrapper JAR
exec java -jar "$WRAPPER_JAR" "$@"
